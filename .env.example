ENVIRONMENT=development

# Obligatoria. Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# URL pública con la que se arman los magic links
PUBLIC_BASE_URL=https://localhost:8443

DATABASE_URL=sqlite+aiosqlite:///./data/app.db
REDIS_URL=redis://redis:6379/0

# En desarrollo sin Caddy (uvicorn directo por http) poner ambas en false
FORCE_HTTPS=true
COOKIE_SECURE=true

SESSION_TTL_MINUTES=60
VERIFICATION_TTL_MINUTES=15
VERIFICATION_MAX_ATTEMPTS=5

# smtp | console (console escribe el código en el log: solo para desarrollo)
MAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_USE_TLS=false
MAIL_FROM=Autoauditoría <no-reply@localhost>

# API key de https://haveibeenpwned.com/API/Key
HIBP_API_KEY=
HIBP_USER_AGENT=herramienta-osint-autoauditoria
# Debe coincidir con el plan contratado en HIBP
HIBP_REQUESTS_PER_MINUTE=10
HIBP_MAX_RETRIES=4

RESULT_TTL_SECONDS=600
MAX_UPLOAD_BYTES=15728640
RATE_LIMIT_GLOBAL_PER_MINUTE=120
